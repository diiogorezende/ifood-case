# --- Project-specific ---
._*
*.tar.gz

# Virtual environments
.venv/
venv/
env/

# DVC (raw data tracked via .dvc pointer files; ignore actual data + local cache/config)
.dvc/
data/raw/*
!data/raw/*.dvc
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Testing / linting / type-checking caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
